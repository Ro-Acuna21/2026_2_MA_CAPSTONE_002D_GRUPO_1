        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass users {\n  - bigint id\n  - string name\n  - string email\n  - string password\n  - string system_role\n  - timestamp email_verified_at\n  - boolean is_active\n  - string remember_token\n  - timestamp created_at\n  - timestamp updated_at\n  - timestamp deleted_at\n  + iniciarSesion()\n  + cerrarSesion()\n  + consultarCuenta()\n}\n\nclass medical_centers {\n  - bigint id\n  - string name\n  - string slug\n  - string database_name\n  - string rut\n  - string address\n  - string phone\n  - string email\n  - boolean is_active\n  - string plan\n  - string subscription_status\n  - timestamp subscription_ends_at\n  - string provisioning_status\n  - timestamp provisioned_at\n  - text public_description\n  - timestamp created_at\n  - timestamp updated_at\n  + consultarCentro()\n  + actualizarDatos()\n}\n\nclass center_users {\n  - bigint id\n  - bigint medical_center_id\n  - bigint user_id\n  - string role\n  - bigint patient_id\n  - bigint professional_id\n  - boolean is_active\n  - boolean invitation_pending\n  - timestamp invitation_sent_at\n  - timestamp created_at\n  - timestamp updated_at\n  + asignarAcceso()\n  + cambiarRol()\n  + activarDesactivarAcceso()\n}\n\nclass patients {\n  - bigint id\n  - bigint user_id\n  - bigint health_insurance_id\n  - string first_name\n  - string last_name\n  - string rut\n  - date birth_date\n  - string email\n  - string phone\n  - string address\n  - string medical_insurance\n  - timestamp consent_at\n  - string consent_version\n  - boolean is_active\n  - timestamp created_at\n  - timestamp updated_at\n  - timestamp deleted_at\n  + registrarFicha()\n  + consultarFicha()\n  + actualizarFicha()\n}\n\nclass professionals {\n  - bigint id\n  - bigint user_id\n  - string first_name\n  - string last_name\n  - string rut\n  - string email\n  - string phone\n  - text description\n  - boolean is_active\n  - timestamp created_at\n  - timestamp updated_at\n  - timestamp deleted_at\n  + registrarPerfil()\n  + consultarPerfil()\n  + actualizarPerfil()\n}\n\nclass services {\n  - bigint id\n  - bigint specialty_id\n  - string name\n  - text description\n  - smallint duration_minutes\n  - boolean is_active\n  - timestamp created_at\n  - timestamp updated_at\n  + consultarServicio()\n  + crearServicio()\n  + actualizarServicio()\n}\n\nclass appointments {\n  - bigint id\n  - bigint patient_id\n  - bigint professional_id\n  - bigint service_id\n  - date appointment_date\n  - time start_time\n  - time end_time\n  - string status\n  - string source\n  - text note\n  - boolean overbook\n  - bigint created_by\n  - timestamp created_at\n  - timestamp updated_at\n  + crearReserva()\n  + reprogramar()\n  + cancelar()\n  + cambiarEstado()\n}\n\nusers \&quot;1\&quot; --&gt; \&quot;0..*\&quot; center_users : tiene accesos\nmedical_centers \&quot;1\&quot; --&gt; \&quot;0..*\&quot; center_users : registra accesos\n\ncenter_users \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; patients : patient_id\ncenter_users \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; professionals : professional_id\n\npatients \&quot;1\&quot; --&gt; \&quot;0..*\&quot; appointments : tiene reservas\nprofessionals \&quot;1\&quot; --&gt; \&quot;0..*\&quot; appointments : atiende\nservices \&quot;1\&quot; --&gt; \&quot;0..*\&quot; appointments : corresponde a&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="YrTDGjrbMnDVngbTMx-s-148">
